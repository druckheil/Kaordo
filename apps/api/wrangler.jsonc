{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veridimensio-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "preview_urls": false,
  "minify": true,
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "CLOUDFLARE_ACCOUNT_ID",
      "CLOUDFLARE_ACCOUNT_TOKEN",
      "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY",
      "R2_S3_ENDPOINT",
      "SUPERADMIN_USER_ID",
      "TURN_KEY_API_TOKEN",
      "TURN_KEY_ID"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "veridimensio-db",
      "database_id": "14e4a3b7-67c8-4f46-8365-4ac77765ec3d",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_IP_LIMITER",
      "namespace_id": "41001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "AUTH_ACCOUNT_LIMITER",
      "namespace_id": "41002",
      "simple": {
        "limit": 8,
        "period": 60
      }
    },
    {
      "name": "TURN_CREDENTIAL_LIMITER",
      "namespace_id": "41003",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  }
}
