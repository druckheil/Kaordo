{
	"realm": "kaordo",
	"enabled": true,
	"displayName": "Kaordo Identity",
	"loginTheme": "kaordo",
	"rememberMe": true,
	"accessTokenLifespan": 300,
	"ssoSessionIdleTimeout": 2592000,
	"ssoSessionMaxLifespan": 157680000,
	"ssoSessionIdleTimeoutRememberMe": 2592000,
	"ssoSessionMaxLifespanRememberMe": 157680000,
	"clientSessionIdleTimeout": 0,
	"clientSessionMaxLifespan": 0,
	"revokeRefreshToken": true,
	"refreshTokenMaxReuse": 0,
	"registrationAllowed": true,
	"registrationEmailAsUsername": false,
	"loginWithEmailAllowed": false,
	"verifyEmail": false,
	"resetPasswordAllowed": false,
	"bruteForceProtected": true,
	"failureFactor": 5,
	"passwordPolicy": "length(12)",
	"otpPolicyType": "totp",
	"otpPolicyAlgorithm": "HmacSHA1",
	"otpPolicyDigits": 6,
	"otpPolicyPeriod": 30,
	"requiredActions": [
		{
			"alias": "CONFIGURE_TOTP",
			"name": "Configure OTP",
			"providerId": "CONFIGURE_TOTP",
			"enabled": true,
			"defaultAction": true
		},
		{
			"alias": "CONFIGURE_RECOVERY_AUTHN_CODES",
			"name": "Recovery Authentication Codes",
			"providerId": "CONFIGURE_RECOVERY_AUTHN_CODES",
			"enabled": true,
			"defaultAction": true
		}
	],
	"clients": [
		{
			"clientId": "kerno-api",
			"name": "Kerno API",
			"enabled": true,
			"protocol": "openid-connect",
			"publicClient": true,
			"standardFlowEnabled": false,
			"implicitFlowEnabled": false,
			"directAccessGrantsEnabled": false,
			"serviceAccountsEnabled": false
		},
		{
			"clientId": "kaordo-web",
			"name": "Kaordo Web",
			"enabled": true,
			"protocol": "openid-connect",
			"publicClient": true,
			"standardFlowEnabled": true,
			"implicitFlowEnabled": false,
			"directAccessGrantsEnabled": false,
			"serviceAccountsEnabled": false,
			"defaultClientScopes": ["basic", "web-origins", "profile", "roles", "email"],
			"redirectUris": ["${KAORDO_SITE_ORIGIN}/*"],
			"webOrigins": ["${KAORDO_SITE_ORIGIN}"],
			"attributes": {
				"pkce.code.challenge.method": "S256",
				"post.logout.redirect.uris": "+"
			},
			"protocolMappers": [
				{
					"name": "kerno-api-audience",
					"protocol": "openid-connect",
					"protocolMapper": "oidc-audience-mapper",
					"config": {
						"included.custom.audience": "kerno-api",
						"id.token.claim": "false",
						"access.token.claim": "true"
					}
				}
			]
		}
	]
}
