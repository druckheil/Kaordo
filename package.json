{
	"name": "kaordo",
	"private": true,
	"version": "0.0.4",
	"type": "module",
	"packageManager": "pnpm@11.9.0",
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"dev": "node scripts/dev-local.mjs",
		"dev:web": "pnpm build:pages && node scripts/serve-pages.mjs",
		"dev:stop": "node scripts/stop-local.mjs",
		"auth:configure": "node scripts/sync-keycloak.mjs",
		"test:account-preview": "node --test scripts/account-preview.test.mjs scripts/account-session.test.mjs",
		"backup:local": "node scripts/local-backup.mjs backup",
		"backup:verify": "node scripts/local-backup.mjs verify",
		"test:backup:live": "playwright test --project=live backup-live.integration.mjs --workers=1",
		"test:auth": "node --test scripts/account-preview.test.mjs scripts/account-session.test.mjs scripts/api-client.test.mjs scripts/auth-config.test.mjs",
		"test:auth:live": "playwright test --project=live auth-live.integration.mjs --workers=1",
		"test:product:db": "node scripts/product-db.integration.mjs",
		"test:backup": "node --test scripts/backup-config.test.mjs",
		"test:dependencies": "node --test scripts/dependencies.test.mjs",
		"test:dev": "node --test scripts/dev-local.test.mjs",
		"test:media": "node --test scripts/media-upload-storage.test.mjs",
		"build:pages": "node scripts/build-pages.mjs",
		"build:pages:production": "node scripts/build-pages.mjs --production",
		"test:pages:production": "pnpm build:pages:production && node --test scripts/pages-production.test.mjs && node --check scripts/deploy-pages.mjs && bash -n deploy/nixos/deploy-static.sh",
		"deploy:pages:production": "node scripts/deploy-pages.mjs",
		"deploy:production": "node scripts/deploy-production.mjs",
		"test:deploy": "node --test scripts/deploy-production.test.mjs",
		"check:front": "pnpm -r --filter \"@kaordo/*\" run check",
		"test:pages": "pnpm build:pages && node --test scripts/pages.test.mjs scripts/build-pages-config.test.mjs",
		"test:ui-layout": "node --test scripts/media-layout.test.mjs scripts/ligo-message-layout.test.mjs",
		"test:ui-public": "pnpm build:pages && playwright test --project=browser ui-public.test.mjs",
		"test:regado:ui": "playwright test --project=browser regado-ui.test.mjs",
		"test:product:ui": "playwright test --project=browser product-ui.test.mjs",
		"dev:integration": "node scripts/dev-local.mjs --static",
		"test:unit": "node --test scripts/account-preview.test.mjs scripts/account-session.test.mjs scripts/api-client.test.mjs scripts/auth-config.test.mjs scripts/backup-config.test.mjs scripts/build-pages-config.test.mjs scripts/dependencies.test.mjs scripts/deploy-production.test.mjs scripts/dev-local.test.mjs scripts/ligo-message-layout.test.mjs scripts/lingvo-client.test.mjs scripts/media-layout.test.mjs scripts/media-upload-storage.test.mjs scripts/media-clipboard.test.mjs scripts/ci-config.test.mjs scripts/crypto.test.mjs && node --test scripts/vite-dependencies.test.mjs",
		"test:ui": "playwright test --project=browser",
		"test:ui:browsers": "playwright test --config=playwright.audit.config.mjs",
		"test:integration": "KAORDO_START_SERVICES=1 playwright test --project=live --workers=1 --reporter=line",
		"lint": "eslint .",
		"lint:go": "for module in kerno nodo mediaauth regado-agent; do (cd services/$module && go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.14.0 run --build-tags hosttest --config ../../.golangci.yml ./...) || exit 1; done",
		"test:go": "go test -race ./services/kerno/... ./services/nodo/... ./services/mediaauth/... ./services/regado-agent/...",
		"test:host": "node scripts/host-test.mjs",
		"knip": "knip"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.63.0",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"knip": "^6.40.0",
		"libsodium-wrappers": "0.8.4",
		"postcss": "^8.5.28",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sirv": "3.0.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.1"
	}
}
