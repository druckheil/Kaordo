{
  "name": "@kaordo/softui",
  "version": "1.14.2",
  "private": true,
  "description": "A locally vendored SoftUI runtime and component reference for Kaordo.",
  "type": "module",
  "main": "./dist/softui.kaordo.js",
  "style": "./dist/softui.css",
  "types": "./types.d.ts",
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "import": "./dist/softui.kaordo.js",
      "default": "./dist/softui.kaordo.js"
    },
    "./runtime.js": {
      "types": "./runtime.d.ts",
      "import": "./dist/softui.kaordo.js",
      "default": "./dist/softui.kaordo.js"
    },
    "./style.css": "./dist/softui.css",
    "./style.min.css": "./dist/softui.min.css",
    "./tokens.json": "./dist/tokens.json",
    "./source/css": "./src/softui.css",
    "./source/js": "./src/softui.js",
    "./*": "./*"
  },
  "license": "MIT",
  "author": "Siddharth Bhansali (upstream)",
  "repository": {
    "type": "git",
    "url": "https://github.com/siddharth-bhansali/softui.git"
  }
}
